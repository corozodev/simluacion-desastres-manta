VITE_WORLD_API_BASE_URL=https://api.sistemamanta.lexinnovate.com

# Experimental local controller; use the same hostname as the web UI for cookies.
VITE_FLOOD_API_BASE_URL=http://127.0.0.1:8082
# Raster background is optional; native OSM street geometry remains available.
VITE_OSM_TILES_ENABLED=true
VITE_OSM_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_API_TIMEOUT_MS=8000
# Para desarrollo, seleccionar explícitamente una instancia Go autorizada.
# Nunca incluir credenciales en la URL ni en variables VITE_.
