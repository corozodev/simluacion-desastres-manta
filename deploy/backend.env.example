# Install a private copy outside the repository with mode 600.
# Generate API_KEY with python3 -c 'import secrets; print(secrets.token_urlsafe(32))'.
# Never add the populated file to Git, S3 public hosting or frontend bundles.
API_KEY=
LISTEN_ADDR=0.0.0.0:8080
# The image bundles the historical graph plus any generated variants.
# Switch only after validating the matching scenario and graph.
GRAPH_PATH=data/manta-v2.json
SCENARIO_PATH=scenarios/urban/round1.json
SIM_INTERVAL=2s
SIM_CONCURRENCY=16
PREDICTION_ENABLED=true
RISK_WEIGHT=0.6
PREDICTION_WEIGHT=12
# Set the exact deployed CloudFront or custom web origin.
CORS_ORIGINS=https://replace-with-authorized-web-origin.invalid
