# Install a private copy outside the repository with mode 600.
# Generate API_KEY with python3 -c 'import secrets; print(secrets.token_urlsafe(32))'.
# Never add the populated file to Git, S3 public hosting or frontend bundles.
API_KEY=
LISTEN_ADDR=0.0.0.0:8080
# Startup prepares the reviewed catalogue without executing any simulation.
# Public sessions start only after POST /v1/simulations.
GRAPH_PATH=data/manta-v2.json
SCENARIO_PATH=scenarios/urban/round1.json
SIM_INTERVAL=2s
SIM_CONCURRENCY=16
PREDICTION_ENABLED=true
RISK_WEIGHT=0.6
PREDICTION_WEIGHT=12
# Set the exact deployed CloudFront or custom web origin.
CORS_ORIGINS=https://replace-with-authorized-web-origin.invalid

# Never enable the experimental modes in production without passing their gates.
ENABLE_FULL_MODE=false
ENABLE_EXPANDED_MODE=false
SIM_AUTOSTART=false
SIM_MAX_ACTIVE=2
SIM_MAX_FULL_ACTIVE=1
SIM_MAX_RETAINED=8
SIM_MAX_MEMORY_MB=128
SIM_DEFAULT_TICK_INTERVAL=2s
SIM_DEFAULT_MAX_TICKS=150
SIM_IDLE_TTL=2m
SIM_PAUSED_TTL=5m
SIM_COMPLETED_TTL=15m
SIM_MAX_WALL_TIME=15m
SIM_RATE_LIMIT_PER_MINUTE=120
SIM_CREATE_LIMIT_PER_MINUTE=10
# EC2 t3.small / container quota: two vCPUs; avoid host oversubscription in local Docker.
GOMAXPROCS=2
# Optional operator identity and SHA-256 verifier generated by cmd/operator-key.
# Empty values keep administration disabled. Never use API_KEY here.
ADMIN_OPERATOR=
ADMIN_ACCESS_HASH=
ADMIN_ALLOW_INSECURE_LOOPBACK=false
