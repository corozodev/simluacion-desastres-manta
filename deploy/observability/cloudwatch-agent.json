{
  "agent": {
    "metrics_collection_interval": 60,
    "region": "us-east-2",
    "omit_hostname": true,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "CoroDev/MantaSim",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      [
        "InstanceId"
      ]
    ],
    "force_flush_interval": 60,
    "metrics_collected": {
      "cpu": {
        "totalcpu": true,
        "measurement": [
          "cpu_usage_active"
        ],
        "drop_original_metrics": [
          "cpu_usage_active"
        ],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
