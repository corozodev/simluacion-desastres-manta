# Public overrides validated on m7i-flex.large (2 vCPU / 8 GiB), us-east-2.
# Merge into a private mode-600 copy of backend.env.example; preserve credentials.
# Used with rollout-phase5.sh: backend 4 GiB / 2 CPUs, lab 768 MiB / 0.5 CPU.
SIM_AUTOSTART=false
SIM_MAX_ACTIVE=4
SIM_MAX_FULL_ACTIVE=1
SIM_MAX_RETAINED=16
SIM_MAX_MEMORY_MB=1024
SIM_DEFAULT_TICK_INTERVAL=2s
SIM_DEFAULT_MAX_TICKS=150
SIM_IDLE_TTL=2m
SIM_PAUSED_TTL=5m
SIM_COMPLETED_TTL=15m
SIM_MAX_WALL_TIME=15m
SIM_RATE_LIMIT_PER_MINUTE=600
SIM_CREATE_LIMIT_PER_MINUTE=20
ENABLE_FULL_MODE=true
GOMAXPROCS=2
GOMEMLIMIT=3GiB
FLOOD_LAB_UPSTREAM=http://127.0.0.1:8082
