{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperatorInlineOnlyThroughCloudFormation",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:role/deploy-cli-ec2-corodev-phase2",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:user/deploy-cli"
        },
        "StringEquals": {
          "aws:CalledViaLast": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OperatorDeployOnlyTaggedCorodevInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-2:REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:instance/*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:user/deploy-cli"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ssm:resourceTag/Project": "CoroDev",
          "ssm:resourceTag/Name": "corodev-phase2-backend"
        }
      }
    },
    {
      "Sid": "OperatorExactRunShellDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-2::document/AWS-RunShellScript",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:user/deploy-cli"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "OperatorCommandStatusRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::REPLACE_WITH_AUTHORIZED_ACCOUNT_ID:user/deploy-cli"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    }
  ]
}
