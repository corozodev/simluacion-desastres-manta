# Configuración local de make dev / npm run dev:lab. Sin dependencia AWS o mock.
LAB_WEB_PORT=5173
LAB_WORLD_PORT=8080
LAB_FLOOD_PORT=8082
LAB_REFERENCE_ONLINE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# make dev carga este archivo; Go directo sólo lee variables exportadas.
LISTEN_ADDR=127.0.0.1:8080
GRAPH_PATH=data/manta-v2.json
SCENARIO_PATH=scenarios/urban/round1.json
SIM_INTERVAL=2s
SIM_CONCURRENCY=16
SIM_AUTOSTART=false
SIM_MAX_ACTIVE=2
SIM_MAX_FULL_ACTIVE=1
SIM_MAX_RETAINED=8
SIM_MAX_MEMORY_MB=128
SIM_DEFAULT_TICK_INTERVAL=2s
SIM_DEFAULT_MAX_TICKS=150
SIM_IDLE_TTL=2m
SIM_PAUSED_TTL=5m
SIM_COMPLETED_TTL=15m
SIM_MAX_WALL_TIME=6h
SIM_RATE_LIMIT_PER_MINUTE=120
SIM_CREATE_LIMIT_PER_MINUTE=10
PREDICTION_ENABLED=true
RISK_WEIGHT=0.6
PREDICTION_WEIGHT=12
# Generar API_KEY fuera del repositorio. Nunca usar VITE_ ni --dart-define.
API_KEY=
