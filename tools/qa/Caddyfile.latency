# Opt-in diagnostic candidate. Production keeps deploy/Caddyfile unless the
# operator explicitly installs this file; /data uses the existing private volume.
{
	admin off
	email {$TLS_EMAIL}
	log default {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
}

{$API_DOMAIN} {
	map {path} {diagnostic_route} {
		/healthz /healthz
		/grafo /grafo
		/estado /estado
		/paso /paso
		default other
	}
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	log latency {
		output file /data/diagnostics/access.json {
			mode 0600
			roll_size 5MiB
			roll_keep 3
			roll_keep_for 24h
		}
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	log_append upstream_duration_ms {rp.upstream.duration_ms}
	log_append upstream_latency_ms {rp.upstream.latency_ms}
	log_append route {diagnostic_route}
	reverse_proxy corodev-backend:8080
}
