{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "GraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lat",
        "lng"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "GeoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "SpawnZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "geometry",
        "node_ids",
        "weight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/definitions/GeoPoint"
          }
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "GraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "distance_m",
        "road_type",
        "speed_mps",
        "blocked",
        "directed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "road_type": {
          "type": "string",
          "minLength": 1
        },
        "speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blocked": {
          "type": "boolean"
        },
        "directed": {
          "type": "boolean"
        },
        "bridge": {
          "type": "boolean"
        },
        "geometry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GeoPoint"
          }
        }
      }
    },
    "Shelter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "capacity",
        "occupancy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "occupancy": {
          "type": "integer",
          "minimum": 0
        },
        "reserved": {
          "type": "integer",
          "minimum": 0
        },
        "available": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "nodes",
        "edges",
        "shelters"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphEdge"
          }
        },
        "shelters": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/Shelter"
          }
        },
        "spawn_zones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpawnZone"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GeoPoint"
          }
        }
      }
    },
    "Zombie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "current_node",
        "movement_state",
        "awake",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "walker",
            "runner",
            "horde",
            "sleeper"
          ]
        },
        "current_node": {
          "type": "string",
          "minLength": 1
        },
        "movement_state": {
          "type": "string"
        },
        "awake": {
          "type": "boolean"
        },
        "path": {
          "type": "array",
          "description": "Recorrido del turno incluyendo origen, nodos intermedios y destino.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Survivor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "current_node",
        "status",
        "target_shelter_id",
        "planned_route"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "current_node": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "bitten",
            "evacuated"
          ]
        },
        "target_shelter_id": {
          "type": "string"
        },
        "spawn_zone_id": {
          "type": "string"
        },
        "planned_route": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "WorldEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "type",
        "entity_id",
        "edge_id",
        "message"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "edge_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "WorldMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evacuated",
        "bitten",
        "active",
        "turns",
        "requests_success",
        "requests_invalid",
        "requests_timeout",
        "http_p50_ms",
        "http_p95_ms",
        "http_p99_ms",
        "availability"
      ],
      "properties": {
        "evacuated": {
          "type": "integer",
          "minimum": 0
        },
        "bitten": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "requests_success": {
          "type": "integer",
          "minimum": 0
        },
        "requests_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "requests_timeout": {
          "type": "integer",
          "minimum": 0
        },
        "http_p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "http_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "http_p99_ms": {
          "type": "number",
          "minimum": 0
        },
        "availability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "WorldSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "world_version",
        "graph_version",
        "zombies",
        "survivors",
        "shelters",
        "blocked_edges",
        "events",
        "metrics"
      ],
      "properties": {
        "scenario_type": {
          "type": "string",
          "enum": [
            "urban_flood"
          ],
          "description": "Presente en inundación experimental; ausente en zombie histórico."
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "world_version": {
          "type": "integer",
          "minimum": 0
        },
        "graph_version": {
          "type": "string"
        },
        "zombies": {
          "type": "array",
          "description": "Solo zombies visibles; los sleepers dormidos se excluyen completamente.",
          "items": {
            "$ref": "#/definitions/Zombie"
          }
        },
        "survivors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Survivor"
          }
        },
        "shelters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Shelter"
          }
        },
        "blocked_edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorldEvent"
          }
        },
        "metrics": {
          "$ref": "#/definitions/WorldMetrics"
        },
        "simulation": {
          "$ref": "#/definitions/SimulationInfo"
        }
      }
    },
    "FloodZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "center",
        "radius_m",
        "intensity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "center": {
          "$ref": "#/definitions/GeoPoint"
        },
        "radius_m": {
          "type": "number",
          "minimum": 0
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Exposición sintética normalizada, no profundidad del agua."
        }
      }
    },
    "RoadCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "state",
        "risk_score",
        "risk_source",
        "updated_at_simulation_step",
        "cost_multiplier"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "passable",
            "caution",
            "blocked"
          ]
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_source": {
          "type": "string",
          "minLength": 1
        },
        "updated_at_simulation_step": {
          "type": "integer",
          "minimum": 0
        },
        "cost_multiplier": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "ShelterCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shelter_id",
        "state",
        "risk_score",
        "updated_at_simulation_step"
      ],
      "properties": {
        "shelter_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "full",
            "exposed",
            "inaccessible"
          ]
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "updated_at_simulation_step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FloodAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "current_node",
        "state",
        "behavior",
        "target_shelter_id",
        "planned_route"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "current_node": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "waiting",
            "moving",
            "isolated",
            "evacuated"
          ]
        },
        "behavior": {
          "type": "string",
          "enum": [
            "preventive",
            "late",
            "adaptive"
          ]
        },
        "target_shelter_id": {
          "type": "string"
        },
        "planned_route": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evacuation_time": {
          "type": "number",
          "minimum": 0,
          "description": "Tiempo simulado de llegada al refugio; ausente hasta evacuar."
        }
      }
    },
    "EvacuationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_agents",
        "evacuated_agents",
        "isolated_agents",
        "waiting_agents",
        "average_evacuation_time",
        "blocked_edges",
        "caution_edges",
        "shelters_at_capacity",
        "reroute_count",
        "simulation_total_duration"
      ],
      "properties": {
        "total_agents": {
          "type": "integer",
          "minimum": 0
        },
        "evacuated_agents": {
          "type": "integer",
          "minimum": 0
        },
        "isolated_agents": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_agents": {
          "type": "integer",
          "minimum": 0
        },
        "average_evacuation_time": {
          "type": "number",
          "minimum": 0,
          "description": "Media entre agentes evacuados, en unidades del reloj simulado; cero si no hay evacuados."
        },
        "blocked_edges": {
          "type": "integer",
          "minimum": 0
        },
        "caution_edges": {
          "type": "integer",
          "minimum": 0
        },
        "shelters_at_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "reroute_count": {
          "type": "integer",
          "minimum": 0
        },
        "simulation_total_duration": {
          "type": "number",
          "minimum": 0,
          "description": "Tiempo transcurrido en el reloj simulado, separado del rendimiento del proceso."
        }
      }
    },
    "SimulationPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_step_latency_ms",
        "simulation_total_duration_ms"
      ],
      "properties": {
        "simulation_step_latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Duración de procesamiento del último paso en milisegundos de reloj real."
        },
        "simulation_total_duration_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Duración de procesamiento acumulada en milisegundos de reloj real; no determinista."
        }
      }
    },
    "DataProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_source",
        "model",
        "elevation_source",
        "disclaimer"
      ],
      "properties": {
        "graph_source": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "elevation_source": {
          "type": "string",
          "description": "Fuente verificable de elevación o indicación explícita de que no se usaron elevaciones."
        },
        "disclaimer": {
          "type": "string",
          "description": "Limitación científica del modelo sintético de inundación."
        }
      }
    },
    "ScenarioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_type",
        "simulation_step",
        "world_version",
        "graph_version",
        "simulation_time",
        "simulation_duration",
        "time_step",
        "rainfall",
        "flood_zones",
        "road_conditions",
        "shelter_conditions",
        "agents",
        "evacuation_metrics",
        "performance",
        "data_provenance"
      ],
      "properties": {
        "scenario_type": {
          "type": "string",
          "enum": [
            "urban_flood"
          ]
        },
        "simulation_step": {
          "type": "integer",
          "minimum": 0
        },
        "world_version": {
          "type": "integer",
          "minimum": 0
        },
        "graph_version": {
          "type": "string",
          "minLength": 1
        },
        "simulation_time": {
          "type": "number",
          "minimum": 0,
          "description": "Reloj simulado; simulation_step multiplicado por time_step."
        },
        "simulation_duration": {
          "type": "number",
          "minimum": 0,
          "description": "Duración configurada en unidades del reloj simulado."
        },
        "time_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rainfall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Intensidad sintética normalizada del paso actual; no precipitación medida."
        },
        "flood_zones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FloodZone"
          }
        },
        "road_conditions": {
          "type": "array",
          "description": "Overlay por ID sobre /grafo, sin duplicar geometrías viales.",
          "items": {
            "$ref": "#/definitions/RoadCondition"
          }
        },
        "shelter_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShelterCondition"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FloodAgent"
          }
        },
        "evacuation_metrics": {
          "$ref": "#/definitions/EvacuationMetrics"
        },
        "performance": {
          "$ref": "#/definitions/SimulationPerformance"
        },
        "data_provenance": {
          "$ref": "#/definitions/DataProvenance"
        }
      }
    },
    "StepRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sobrevivienteId",
        "nodoActual",
        "turno"
      ],
      "properties": {
        "sobrevivienteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nodoActual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "turno": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StepResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siguienteNodo"
      ],
      "properties": {
        "siguienteNodo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service",
        "version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "DemoItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending",
            "completed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "pageSize",
        "total"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ItemListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "pagination"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DemoItem"
          }
        },
        "pagination": {
          "$ref": "#/definitions/Pagination"
        }
      }
    },
    "SubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S",
          "description": "Se recortan espacios exteriores; debe contener al menos un carácter no blanco."
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "SubmitResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submissionId",
        "status",
        "message"
      ],
      "properties": {
        "submissionId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorResponseError"
        }
      }
    },
    "ErrorResponseError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "INTERNAL_ERROR",
            "UNAUTHORIZED",
            "CONFLICT",
            "UNAVAILABLE",
            "TIMEOUT",
            "METHOD_NOT_ALLOWED"
          ]
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "SimulationInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "mode",
        "round",
        "state",
        "seed",
        "graph_version",
        "turn_limit",
        "interval_ms"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "competition",
            "full",
            "expanded"
          ]
        },
        "round": {
          "type": "string",
          "enum": [
            "round1",
            "round2",
            "round3"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "starting",
            "running",
            "finished",
            "failed"
          ]
        },
        "seed": {
          "type": "integer",
          "format": "int64"
        },
        "graph_version": {
          "type": "string"
        },
        "turn_limit": {
          "type": "integer",
          "enum": [
            150
          ]
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": "string"
        },
        "ended_at": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        }
      }
    },
    "GraphPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nodes",
        "edges",
        "graph_version",
        "source",
        "coverage",
        "experimental",
        "enabled",
        "preview_available",
        "disabled_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "competition",
            "full",
            "expanded"
          ]
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "integer",
          "minimum": 1
        },
        "graph_version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "experimental": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "preview_available": {
          "type": "boolean"
        },
        "disabled_reason": {
          "type": "string"
        }
      }
    },
    "SimulationRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "survivors",
        "turns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "round1",
            "round2",
            "round3"
          ]
        },
        "name": {
          "type": "string"
        },
        "survivors": {
          "type": "integer",
          "enum": [
            20,
            80,
            200
          ]
        },
        "turns": {
          "type": "integer",
          "enum": [
            150
          ]
        }
      }
    },
    "SimulationCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "presets",
        "rounds",
        "admin_enabled",
        "history_limit"
      ],
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "competition"
          ]
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphPreset"
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SimulationRound"
          }
        },
        "admin_enabled": {
          "type": "boolean"
        },
        "history_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "OperatorSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "authenticated"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authenticated": {
          "type": "boolean"
        },
        "operator": {
          "type": "string"
        },
        "csrf_token": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      }
    },
    "OperatorLogin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "access_code"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "access_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Código aleatorio de256bits introducido por el operador. Nunca se incluye en bundles."
        }
      }
    },
    "StartSimulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "round",
        "seed",
        "expected_run_id"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "competition",
            "full",
            "expanded"
          ]
        },
        "round": {
          "type": "string",
          "enum": [
            "round1",
            "round2",
            "round3"
          ]
        },
        "seed": {
          "type": "integer",
          "format": "int64",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "expected_run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    }
  }
}
